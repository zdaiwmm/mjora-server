<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>invalid.example.confirmed-update-host</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/YOU/Library/Application Support/ConfirmedUpdate/update_host.py</string>
    <string>--config</string>
    <string>/Users/YOU/Library/Application Support/ConfirmedUpdate/config.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DEVELOPER_DIR</key><string>/Applications/Xcode.app/Contents/Developer</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Application Support/ConfirmedUpdate/state/host.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Application Support/ConfirmedUpdate/state/host.log</string>
</dict>
</plist>
